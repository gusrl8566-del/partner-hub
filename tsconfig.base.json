{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@partner-hub/shared": ["packages/shared/src"],
      "@partner-hub/shared/*": ["packages/shared/src/*"]
    }
  }
}
